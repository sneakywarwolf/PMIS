generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AVP
  TEAM_LEAD
  TESTER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETED
}

enum FindingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReportGenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VulnerabilityCategory {
  APPLICATION_API
  NETWORK
}

enum VulnerabilityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  TEAM_ASSIGNED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_REASSIGNED
  PROJECT_SUBMITTED
  PROJECT_APPROVED
  PROJECT_REJECTED
  REPORT_GENERATED
  REPORT_DELETED
  PROJECT_DELETED
  PROJECT_RETENTION_DELETED
  ATTACHMENT_RETENTION_DELETED
  USER_RETENTION_PURGED
  TEMPLATE_FIELD_ADDED
  TEMPLATE_UPLOADED
  TEMPLATE_ACTIVATED
  TEMPLATE_DEACTIVATED
  TEMPLATE_DELETED
  VULNERABILITY_REQUESTED
  VULNERABILITY_APPROVED
  VULNERABILITY_REJECTED
  VULNERABILITY_CREATED
  VULNERABILITY_UPDATED
  VULNERABILITY_DELETED
  SETTINGS_UPDATED
  ACCOUNT_LOCKED
  ACCOUNT_LOCK_EXPIRED
  ACCOUNT_UNLOCKED
  ADMIN_OVERRIDE
  QUIZ_QUESTION_CREATED
  QUIZ_QUESTION_UPDATED
  QUIZ_QUESTION_DELETED
  CYBERDIGEST_EVIDENCE_ADDED
  CYBERDIGEST_EVIDENCE_RETRACTED
  CYBERDIGEST_ZERODAY_TRANSITION
  CYBERDIGEST_ZERODAY_APPROVED
  CYBERDIGEST_ZERODAY_WITHDRAWN
  CYBERDIGEST_STORY_APPROVED
  CYBERDIGEST_STORY_REJECTED
  CYBERDIGEST_STORY_CORRECTED
  CYBERDIGEST_SOURCE_UPDATED
  CYBERDIGEST_DIGEST_GENERATED
  CYBERDIGEST_DIGEST_PUBLISHED
  CYBERDIGEST_DIGEST_WITHDRAWN
  CYBERDIGEST_CONFIG_UPDATED
  CYBERDIGEST_ALLOWLIST_CHANGED
  CYBERDIGEST_SOURCE_ADDED
  CYBERDIGEST_BULK_APPROVED
}

enum ComplianceType {
  VAPT
  CERT_IN
  PCI
  ASV
}

enum TemplateCategory {
  PCI
  VAPT
  CERT_IN
  ASV
}

enum ReportFormat {
  WORD
  EXCEL
}

enum TemplateSubType {
  WEB
  API
  MOBILE
  THICK_CLIENT
  NETWORK
  APPLICATION
  SCR
}

enum TemplateFieldCategory {
  PROJECT_INFO
  VULNERABILITY
  CONTACT
  DATE
  OTHER
}

enum NotificationType {
  USER_CREATED
  USER_UPDATED
  VULNERABILITY_REQUESTED
  VULNERABILITY_APPROVED
  VULNERABILITY_REJECTED
  VULNERABILITY_EDITED
  VULNERABILITY_CHANGE_REQUESTED
  VULNERABILITY_CHANGE_APPROVED
  VULNERABILITY_CHANGE_REJECTED
  QUIZ_QUESTION_LIVE
  QUIZ_ANSWER_REVEALED
  SYSTEM_UPDATE
  PROJECT_ASSIGNED
  CYBERDIGEST_DIGEST
  CYBERDIGEST_SOURCE_DOWN
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole

  assignedTlId  String?   @map("assigned_tl_id")
  assignedTl    User?     @relation("TeamLeadTester", fields: [assignedTlId], references: [id])
  testers       User[]    @relation("TeamLeadTester")

  managerId     String?   @map("manager_id")
  manager       User?     @relation("UserManager", fields: [managerId], references: [id])
  subordinates  User[]    @relation("UserManager")

  fullName      String?   @map("full_name")
  phone         String?   @map("phone")
  designation   String?   @map("designation")
  // Team lead only: custom team name shown on Quiz/Arcade boards (never used elsewhere in PMIS).
  quizTeamName  String?   @map("quiz_team_name")

  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  isForcePasswordChange Boolean @default(false) @map("is_force_password_change")

  totpSecret    String?   @map("totp_secret")
  isTotpEnabled Boolean   @default(false) @map("is_totp_enabled")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  projectsOwned    Project[] @relation("ProjectTester")
  projectsManaged  Project[] @relation("ProjectTL")
  findings         Finding[]
  auditLogsAsActor AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
  projectChanges   ProjectChange[]
  templatesUploaded ReportTemplate[]
  reportGenerations ReportGeneration[]
  vulnRequests     Vulnerability[] @relation("VulnRequester")
  vulnReviews      Vulnerability[] @relation("VulnReviewer")
  vulnChangeRequests VulnerabilityChangeRequest[] @relation("VulnChangeRequester")
  vulnChangeTargetTl VulnerabilityChangeRequest[] @relation("VulnChangeTargetTl")
  vulnChangeReviews  VulnerabilityChangeRequest[] @relation("VulnChangeReviewer")
  notifications    Notification[]
  quizQuestions    QuizQuestion[]
  quizAttempts     QuizAttempt[]
  quizStats        QuizUserStats?
  patternMapScores PatternMapScore[]

  @@index([assignedTlId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  clientName  String        @map("client_name")
  scope       String?
  startDate   DateTime      @map("start_date")
  startDateChangedAt DateTime? @map("start_date_changed_at")
  endDate     DateTime?     @map("end_date")
  status      ProjectStatus @default(NOT_STARTED)
  complianceStatus String?   @default("In-Progress") @map("compliance_status")
  complianceType ComplianceType? @map("compliance_type")

  testerId    String        @map("tester_id")
  tester      User          @relation("ProjectTester", fields: [testerId], references: [id])
  tlId        String        @map("tl_id")
  tl          User          @relation("ProjectTL", fields: [tlId], references: [id])

  templateId  String?       @map("template_id")
  template    ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  category    TemplateCategory @default(VAPT) @map("category")
  subType     TemplateSubType  @default(WEB) @map("sub_type")

  // Report detail fields
  appVersion         String?  @map("app_version")
  location           String?  @map("location")
  // Client point of contact for the report (all optional)
  clientSpocName        String? @map("client_spoc_name")
  clientSpocDesignation String? @map("client_spoc_designation")
  clientSpocEmail       String? @map("client_spoc_email")
  documentVersion    String?  @map("document_version")
  toolsUsed          String?  @map("tools_used")
  testingEnvironment String?  @map("testing_environment")
  qaReviewerName     String?  @map("qa_reviewer_name")
  applicationDetails String?  @map("application_details")
  testingType        String?  @map("testing_type")
  loginSystemTypes   String?  @map("login_system_types")
  applicationNature  String?  @map("application_nature")
  testingLimitation  String?  @map("testing_limitation")
  mobilePlatform     String?  @map("mobile_platform")
  sha1               String?  @map("sha1")
  // SCR projects: where the source code is, and the system the scan ran on.
  codeLocation       String?  @map("code_location")
  systemUsername     String?  @map("system_username")
  systemHostname     String?  @map("system_hostname")
  externalInternal   String?  @map("external_internal")
  networkActivityType String? @map("network_activity_type")
  totalScopeCount    Int?     @map("total_scope_count")
  networkScope       Json?    @map("network_scope")
  quarter            String?  @map("quarter")
  nmapPorts          Json?    @map("nmap_ports")
  // SCR projects: uploaded Site Map rows [{ directoryName, fileName }].
  siteMap            Json?    @map("site_map")
  projectVulnerabilities ProjectVulnerability[]
  // Structured rows for {Tool Name}/{Tool Version}/{Open Source/Licensed} —
  // toolsUsed (free text) is kept in sync as a derived summary so the
  // existing {Tools Used} single-line placeholder keeps working.
  toolsUsedTable     Json?    @map("tools_used_table")

  // Next report generation for this project is "1.{reportVersionCounter}".
  // Only incremented when a generation actually COMPLETEs (never on
  // creation/failure), and never decremented — so failed generations don't
  // burn a version number, and deleting an old report can't cause reuse.
  reportVersionCounter Int    @default(0) @map("report_version_counter")

  customFieldValues Json?   @map("custom_field_values")

  reportDocxPath  String?   @map("report_docx_path")
  reportPdfPath   String?   @map("report_pdf_path")
  generatedAt     DateTime? @map("generated_at")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  findings    Finding[]
  reportGenerations ReportGeneration[]
  changes     ProjectChange[]

  @@index([testerId])
  @@index([tlId])
  @@index([status])
  @@index([templateId])
  @@map("projects")
}

// One row per field changed while a project was COMPLETED (edits before completion
// are not recorded). Values are the stored before/after, taken inside the update
// transaction. Append-only: a field edited repeatedly keeps its full history.
model ProjectChange {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName   String   @map("project_name")
  field         String
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  // Null once the user is purged (retention); the name snapshot stays.
  changedById   String?  @map("changed_by_id")
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedByName String   @map("changed_by_name")
  changedAt     DateTime @default(now()) @map("changed_at")

  @@index([projectId, changedAt])
  @@map("project_changes")
}

model ReportTemplate {
  id            String    @id @default(cuid())
  name          String
  filePath      String    @map("file_path")
  /// Original uploaded filename (e.g. "App-Security-Test_{Client-Name}_{Application-Name}_Web_{Document Version}_{Report Generation Date}_Non-Compliant.docx"),
  /// used as the naming pattern for generated reports. Null for templates
  /// uploaded before this column existed.
  originalFileName String? @map("original_file_name")
  fileHash      String    @map("file_hash")

  category      TemplateCategory @default(VAPT) @map("category")
  subType       TemplateSubType  @default(WEB) @map("sub_type")
  // Further Activity Types this same template also serves (the primary one stays in subType).
  extraSubTypes TemplateSubType[] @default([]) @map("extra_sub_types")
  projectType   String    @map("project_type")
  /// Word (.docx) or Excel (.xlsx) template; activation only replaces a template of the same format.
  reportFormat  ReportFormat @default(WORD) @map("report_format")

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")

  uploadedById  String    @map("uploaded_by")
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projects      Project[]
  fields        TemplateField[]
  reportGenerations ReportGeneration[]

  @@index([category])
  @@index([subType])
  @@index([projectType])
  @@index([reportFormat])
  @@index([isActive])
  @@index([effectiveFrom])
  @@map("report_templates")
}

model TemplateField {
  id            String    @id @default(cuid())
  templateId    String    @map("template_id")
  template      ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name          String
  normalizedName String   @map("normalized_name")
  category      TemplateFieldCategory @default(OTHER) @map("field_category")
  description   String?
  isRepeatable  Boolean   @default(false) @map("is_repeatable")
  isCustom      Boolean   @default(false) @map("is_custom")
  sortOrder     Int       @default(0) @map("sort_order")
  /// Admin-selected canonical application parameter key this field maps to
  /// (e.g. "project.startDate"). Null = fall back to automatic fuzzy matching.
  mappedParameter String? @map("mapped_parameter")

  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([templateId])
  @@index([category])
  @@map("template_fields")
}

model ReportGeneration {
  id            String    @id @default(cuid())

  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Nullable + SetNull: deleting the source template (e.g. on replace) must
  /// never touch this row or its already-generated docxPath/pdfPath file —
  /// it just severs the "which template produced this" pointer.
  templateId    String?   @map("template_id")
  template      ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  generatedById String    @map("generated_by")
  generatedBy   User      @relation(fields: [generatedById], references: [id])

  fieldData     Json      @map("field_data")
  version       String    @default("1.0")
  status        ReportGenerationStatus @default(PENDING)
  error         String?

  docxPath      String?   @map("docx_path")
  pdfPath       String?   @map("pdf_path")

  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([projectId])
  @@index([templateId])
  @@index([generatedById])
  @@map("report_generations")
}

model Vulnerability {
  id          String   @id @default(cuid())
  name        String
  severity    String
  cvssScore   Float?   @map("cvss_score")
  cvssVector  String?  @map("cvss_vector")
  description String
  impact      String
  remediation String
  references  String
  cveId       String?  @map("cve_id")
  cweId       String?  @map("cwe_id")
  source      String   @default("internal")
  category    VulnerabilityCategory @default(APPLICATION_API)

  status      VulnerabilityStatus @default(APPROVED) @map("status")
  isActive    Boolean  @default(true) @map("is_active")
  requestedById String? @map("requested_by")
  requestedBy User?    @relation("VulnRequester", fields: [requestedById], references: [id])
  reviewedById String? @map("reviewed_by")
  reviewedBy  User?    @relation("VulnReviewer", fields: [reviewedById], references: [id])
  reviewedAt  DateTime? @map("reviewed_at")

  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  findings    Finding[]
  changeRequests VulnerabilityChangeRequest[]

  @@index([severity])
  @@index([name])
  @@index([status])
  @@index([isActive])
  @@map("vulnerabilities")
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A Tester's proposed edit to an already-approved Vulnerability DB record.
// The original record is untouched until an Admin or the tester's specific
// TL approves it — see VulnerabilitiesService.approveChangeRequest.
model VulnerabilityChangeRequest {
  id              String   @id @default(cuid())

  vulnerabilityId String   @map("vulnerability_id")
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id])

  requestedById   String   @map("requested_by")
  requestedBy     User     @relation("VulnChangeRequester", fields: [requestedById], references: [id])

  // The requester's assigned TL at the time of the request — routes the
  // notification/visibility to that one TL, not every TL in the system.
  targetTlId      String?  @map("target_tl_id")
  targetTl        User?    @relation("VulnChangeTargetTl", fields: [targetTlId], references: [id])

  reviewedById    String?  @map("reviewed_by")
  reviewedBy      User?    @relation("VulnChangeReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime? @map("reviewed_at")

  status          ChangeRequestStatus @default(PENDING)

  beforeData      Json     @map("before_data")
  afterData       Json     @map("after_data")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([vulnerabilityId])
  @@index([targetTlId])
  @@map("vulnerability_change_requests")
}

model Finding {
  id           String        @id @default(cuid())
  projectId    String        @map("project_id")
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Exactly one of vulnId (global Vulnerability DB) or projectVulnId (project-scoped, e.g. Nessus import).
  vulnId       String?       @map("vuln_id")
  vulnerability Vulnerability? @relation(fields: [vulnId], references: [id], onDelete: Restrict)
  projectVulnId String?      @map("project_vuln_id")
  projectVulnerability ProjectVulnerability? @relation(fields: [projectVulnId], references: [id], onDelete: Cascade)

  evidencePaths String[]     @map("evidence_paths")
  testerNotes   String       @map("tester_notes")
  status        FindingStatus @default(DRAFT)

  affectedInstances       String[] @map("affected_instances")
  authenticationType      String?  @map("authentication_type")
  proofOfConcept          String?  @map("proof_of_concept")
  vulnerabilityDependency String?  @map("vulnerability_dependency")
  reportStatus            String   @default("Open") @map("report_status")

  cvssScoreOverride       Float?   @map("cvss_score_override")
  cvssVectorOverride      String?  @map("cvss_vector_override")

  pocSteps    PocStep[]

  createdById  String        @map("created_by")
  createdBy    User          @relation(fields: [createdById], references: [id])

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([vulnId])
  @@index([status])
  @@index([reportStatus])
  @@map("findings")
}

// A vulnerability record owned by ONE project (created by scan imports such as Nessus). It has the
// same content fields as Vulnerability so reports can use it unchanged, but it lives in its own
// table: it never appears in, or changes, the global Vulnerability DB, and other projects can't see it.
model ProjectVulnerability {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Identifier from the source tool (Nessus plugin ID); with projectId it prevents duplicate imports.
  source      String   @default("nessus")
  sourceKey   String   @map("source_key")
  // How the finding is classified in PMIS; every scan-imported record is a VA Finding.
  classification String @default("VA Finding")

  name        String
  severity    String
  cvssScore   Float?   @map("cvss_score")
  cvssVector  String?  @map("cvss_vector")
  // nessus | calculated | unresolved (see common/cvss-vector.util.ts); null on records imported before this existed.
  cvssVectorSource String? @map("cvss_vector_source")
  description String
  impact      String
  remediation String
  references  String
  cveId       String?  @map("cve_id")
  cweId       String?  @map("cwe_id")

  createdAt   DateTime @default(now()) @map("created_at")

  findings    Finding[]

  @@unique([projectId, source, sourceKey])
  @@map("project_vulnerabilities")
}

model PocStep {
  id          String   @id @default(cuid())
  findingId   String   @map("finding_id")
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  stepNo      Int      @map("step_no")
  description String   @map("description")
  // First PoC of the step. Further PoCs follow in `extraImagePaths`, in upload order (see common/poc-images.util.ts).
  imagePath   String?  @map("image_path")
  extraImagePaths String[] @default([]) @map("extra_image_paths")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([findingId])
  @@map("poc_steps")
}

model AuditLog {
  id          String     @id @default(cuid())
  // Null once the acting user has been permanently purged (retention); the entry itself is kept.
  actorId     String?    @map("actor_id")
  actor       User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action      AuditAction
  targetType  String?    @map("target_type")
  targetId    String?    @map("target_id")
  targetUserId String?   @map("target_user_id")
  targetUser  User?      @relation("AuditTarget", fields: [targetUserId], references: [id])

  details     Json?
  ipAddress   String     @map("ip_address")
  userAgent   String     @map("user_agent")

  timestamp   DateTime   @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([timestamp])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String
  read        Boolean  @default(false)
  linkUrl     String?  @map("link_url")
  relatedId   String?  @map("related_id")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// Singleton row (id is always "singleton") holding all admin-configurable
// application settings as JSON. Keeping this as one flexible JSON blob
// avoids a migration for every new setting; validation of shape/ranges
// happens in SettingsService, not the schema.
model AppSettings {
  id          String   @id @default("singleton")
  data        Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum QuizStatus {
  SCHEDULED
  ACTIVE
  REVEALED
}

enum QuizBadge {
  FIRST_CORRECT
  STREAK_5
  STREAK_10
  STREAK_30
  ANSWERED_50
  ANSWERED_100
  PERFECT_WEEK
}

model QuizQuestion {
  id           String        @id @default(cuid())
  question     String
  options      String[]
  correctIndex Int
  explanation  String
  scheduledFor DateTime
  status       QuizStatus    @default(SCHEDULED)
  revealedAt   DateTime?
  createdById  String        @map("created_by_id")
  createdBy    User          @relation(fields: [createdById], references: [id])
  attempts     QuizAttempt[]
  createdAt    DateTime      @default(now())

  @@map("quiz_questions")
}

model QuizAttempt {
  id             String       @id @default(cuid())
  questionId     String       @map("question_id")
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  selectedOption Int
  isCorrect      Boolean
  pointsAwarded  Int          @default(0)
  answeredAt     DateTime     @default(now())
  // Answered after the question's reveal: shown to the user, never scored or counted.
  isLate         Boolean      @default(false) @map("is_late")

  @@unique([questionId, userId])
  @@map("quiz_attempts")
}

model QuizUserStats {
  userId         String      @id @map("user_id")
  user           User        @relation(fields: [userId], references: [id])
  totalPoints    Int         @default(0)
  currentStreak  Int         @default(0)
  bestStreak     Int         @default(0)
  lastAnsweredOn DateTime?
  badges         QuizBadge[]

  @@map("quiz_user_stats")
}

// Arcade "Pattern Map" break-time game. Deliberately separate from the Quiz
// tables: its scores never feed Quiz points, streaks, scorecard or leaderboard.
model PatternMapScore {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  score         Int
  roundsCleared Int      @map("rounds_cleared")
  accuracy      Int
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([score])
  @@map("pattern_map_scores")
}

// ---------------------------------------------------------------------------
// Cyberdigest (verified cybersecurity intelligence digest) - Phase 1: sources,
// raw evidence and stories. Verification / zero-day / digest models come later.
// ---------------------------------------------------------------------------

enum DigestSourceType {
  NEWS_RSS
  RESEARCH_RSS
  CVE_API
  NVD_API
  KEV_JSON
}

enum DigestSourceHealth {
  UNKNOWN
  HEALTHY
  STALE
  FAILING
}

// Fail-closed: a story starts PENDING and only a later verification step may move it.
enum DigestVerificationState {
  PENDING
  ATTRIBUTED
  VERIFIED
  CONFLICTING
  REJECTED
  SOURCE_UNAVAILABLE
}

model DigestSource {
  id                  String             @id @default(uuid())
  slug                String             @unique
  name                String
  type                DigestSourceType
  endpoint            String
  website             String
  trustRole           String // DISCOVERY | AUTHORITATIVE
  enabled             Boolean            @default(true)
  pollIntervalMinutes Int
  health              DigestSourceHealth @default(UNKNOWN)
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastError           String?
  consecutiveFailures Int                @default(0)
  etag                String?
  lastModified        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  rawItems DigestRawItem[]
  stories  DigestStory[]
}

// Immutable evidence: exactly what a source returned, with a hash. Never edited.
model DigestRawItem {
  id          String       @id @default(uuid())
  sourceId    String
  source      DigestSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId  String
  url         String
  contentHash String
  fetchedAt   DateTime     @default(now())
  payload     Json

  @@unique([sourceId, externalId, contentHash])
  @@index([sourceId, fetchedAt])
}

model DigestStory {
  id                String                  @id @default(uuid())
  sourceId          String
  source            DigestSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  canonicalUrl      String
  title             String
  author            String?
  publishedAt       DateTime? // null = the source gave no usable date; never guessed
  updatedAtSource   DateTime?
  ingestedAt        DateTime                @default(now())
  lastVerifiedAt    DateTime?
  dedupKey          String                  @unique
  contentHash       String
  summary           String? // extractive only: trimmed text from the source itself
  cveIds            String[]
  groupId           String?
  verificationState DigestVerificationState @default(PENDING)
  rawItemId         String?
  categories        String[] // rule-based labels from the publisher's own text; never from a model
  stateNote         String? // why the story is in this state (conflict detail, review reason)
  reviewedById      String?
  reviewedAt        DateTime?

  @@unique([sourceId, canonicalUrl])
  @@index([publishedAt])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Cyberdigest phase 2: authoritative CVE / NVD / CISA KEV data.
// Record existence, enrichment, severity and KEV status are SEPARATE facts and
// are only ever written by the verification code from retrieved data.
// ---------------------------------------------------------------------------

enum DigestCveRecordStatus {
  PUBLISHED
  RESERVED
  REJECTED
  NOT_FOUND // CVE.org has no public record for this id (not the same as "invalid")
  UNAVAILABLE // CVE.org could not be reached; nothing is known
}

enum DigestNvdEnrichment {
  PENDING // NVD has no record yet, or has not finished analysis
  ENRICHED
  UNAVAILABLE // NVD could not be reached
}

model DigestCve {
  id                String                @id @default(uuid())
  cveId             String                @unique
  recordStatus      DigestCveRecordStatus
  description       String? // official CVE.org text, never rewritten
  assigner          String?
  recordPublishedAt DateTime?
  recordUpdatedAt   DateTime?
  affected          Json? // CNA affected products exactly as published
  references        Json?
  cvss              Json? // [{provider, source, version, score, vector, severity}] one entry per provider, never merged
  maxCvssScore      Float? // highest score any provider gave; used only for filtering/sorting
  maxCvssSeverity   String? // that same provider's own label (not calculated by PMIS)
  vendors           String[] // vendors named by CVE.org / NVD, lower-cased, for filtering
  nvdEnrichment     DigestNvdEnrichment   @default(PENDING)
  nvdStatus         String? // NVD's own vulnStatus string
  nvdLastModified   DateTime?
  nvdAffected       Json? // CPE criteria from NVD
  kevListed         Boolean? // null = KEV catalog unavailable, so unknown (false means checked and absent)
  kevDateAdded      DateTime?
  kevData           Json?
  conflicts         Json? // authoritative sources disagree, e.g. [{field, detail}]
  provenance        Json // {field: {source, url, retrievedAt}}
  lastAttemptAt     DateTime?
  lastVerifiedAt    DateTime? // last time CVE.org was successfully read
  lastError         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([recordStatus])
  @@index([kevListed])
}

model DigestKevEntry {
  cveId            String    @id
  vendorProject    String
  product          String
  name             String
  dateAdded        DateTime
  dueDate          DateTime?
  ransomwareUse    String
  shortDescription String
  notes            String?
  catalogVersion   String
  syncedAt         DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Cyberdigest phase 3: zero-day classification. CONFIRMED is reachable only
// through an analyst approval that the evidence rules allow; never automatically.
// ---------------------------------------------------------------------------

enum DigestZeroDayState {
  CONFIRMED // confirmed zero-day exploitation (evidence rules met AND analyst approved)
  REPORTED_UNVERIFIED // someone reports a zero-day; qualifying evidence missing
  KNOWN_EXPLOITED_UNCONFIRMED // exploitation established; zero-day timeline is not
  NOT_SUBSTANTIATED // evidence contradicts or fails to support the claim
  UNKNOWN // evidence unavailable, conflicting or inconclusive
}

model DigestZeroDayCase {
  id            String             @id @default(uuid())
  cveId         String             @unique
  state         DigestZeroDayState @default(REPORTED_UNVERIFIED)
  stateReasons  Json // why the case is in this state / what evidence is missing
  stateSetById  String? // null = set by the system rules; otherwise the analyst who chose it
  stateSetAt    DateTime           @default(now())
  approvedById  String? // only ever set together with state CONFIRMED
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  evidence DigestZeroDayEvidence[]

  @@index([state])
}

// Immutable once written. A mistake is corrected by retracting and adding new evidence.
model DigestZeroDayEvidence {
  id           String            @id @default(uuid())
  caseId       String
  case         DigestZeroDayCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind         String // EXPLOITATION_OBSERVED | PATCH_RELEASED | NO_PATCH_AVAILABLE | VENDOR_AWARENESS | DISCLOSURE | POC_PUBLIC | ZERO_DAY_CLAIM | CONTRADICTS_EXPLOITATION | CONTRADICTS_ZERO_DAY
  sourceType   String // VENDOR | RESEARCHER | GOVERNMENT | INCIDENT_REPORT | TECHNICAL_INVESTIGATION | NEWS | SOCIAL | OTHER
  sourceName   String
  url          String
  eventDate    DateTime? // the date the SOURCE states for the event; null when it gives none
  note         String?
  addedById    String? // null = added by the system (KEV sync, story scan)
  system       Boolean           @default(false) // true only for rows written by the system's own sync code; no API route can set it
  createdAt    DateTime          @default(now())
  retractedAt  DateTime?
  retractedById String?
  retractReason String?

  @@index([caseId])
}

// ---------------------------------------------------------------------------
// Cyberdigest phase 5: the daily digest. The content is a frozen snapshot of what
// passed the publication gate when it was generated; later corrections are shown
// on top of it, never edited into it.
// ---------------------------------------------------------------------------

enum DigestIssueStatus {
  SHADOW // generated, visible to reviewers only, nobody notified
  PUBLISHED
  WITHDRAWN
}

model DigestIssue {
  id             String            @id @default(uuid())
  digestDate     String            @unique // YYYY-MM-DD, Asia/Kolkata calendar date
  status         DigestIssueStatus
  generatedAt    DateTime          @default(now())
  generatedById  String? // null = generated by the schedule
  windowStart    DateTime
  windowEnd      DateTime
  content        Json
  publishedAt    DateTime?
  publishedById  String?
  withdrawnAt    DateTime?
  withdrawnById  String?
  withdrawReason String?

  @@index([status])
}

// ---------------------------------------------------------------------------
// Cyberdigest: administrator configuration, job history and job locks.
// ---------------------------------------------------------------------------

// One row. moduleEnabledForNonAdmins and pipelineEnabled are deliberately separate switches.
model DigestConfig {
  id                       String   @id @default("singleton")
  moduleEnabledForNonAdmins Boolean @default(true)
  pipelineEnabled          Boolean  @default(true)
  publishTime              String   @default("08:00") // HH:MM in `timezone`
  timezone                 String   @default("Asia/Kolkata")
  publishMode              String   @default("AUTO") // AUTO = publish when the gate passes; HOLD = keep as shadow for an admin
  minDiscoveryCoveragePct  Int      @default(50) // share of enabled news/research sources that must be healthy to publish
  retentionDays            Int      @default(365)
  jobRetryBackoffMinutes   Int      @default(10)
  linkHosts                String[] // exact hostnames users may click through to (admin-managed)
  updatedById              String?
  updatedAt                DateTime @updatedAt
}

model DigestJobRun {
  id         String    @id @default(uuid())
  job        String
  status     String // RUNNING | OK | FAILED | SKIPPED
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  detail     Json?

  @@index([job, startedAt])
}

// A lease, not a permanent lock: it expires, so a crashed worker cannot block a job forever.
model DigestLock {
  name      String   @id
  holder    String
  expiresAt DateTime
}

// Append-only history of what changed and when, per entity.
model DigestEvent {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  event      String
  detail     Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}
