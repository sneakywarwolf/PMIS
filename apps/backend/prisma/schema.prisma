generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AVP
  TEAM_LEAD
  TESTER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETED
}

enum FindingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReportGenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VulnerabilityCategory {
  APPLICATION_API
  NETWORK
}

enum VulnerabilityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  TEAM_ASSIGNED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_REASSIGNED
  PROJECT_SUBMITTED
  PROJECT_APPROVED
  PROJECT_REJECTED
  REPORT_GENERATED
  REPORT_DELETED
  PROJECT_DELETED
  PROJECT_RETENTION_DELETED
  ATTACHMENT_RETENTION_DELETED
  TEMPLATE_UPLOADED
  TEMPLATE_ACTIVATED
  TEMPLATE_DEACTIVATED
  TEMPLATE_DELETED
  VULNERABILITY_REQUESTED
  VULNERABILITY_APPROVED
  VULNERABILITY_REJECTED
  VULNERABILITY_CREATED
  VULNERABILITY_UPDATED
  VULNERABILITY_DELETED
  SETTINGS_UPDATED
  ADMIN_OVERRIDE
  QUIZ_QUESTION_CREATED
  QUIZ_QUESTION_UPDATED
  QUIZ_QUESTION_DELETED
}

enum ComplianceType {
  VAPT
  CERT_IN
  PCI
  ASV
}

enum TemplateCategory {
  PCI
  VAPT
  CERT_IN
  ASV
}

enum TemplateSubType {
  WEB
  API
  MOBILE
  THICK_CLIENT
  NETWORK
  APPLICATION
}

enum TemplateFieldCategory {
  PROJECT_INFO
  VULNERABILITY
  CONTACT
  DATE
  OTHER
}

enum NotificationType {
  USER_CREATED
  USER_UPDATED
  VULNERABILITY_REQUESTED
  VULNERABILITY_APPROVED
  VULNERABILITY_REJECTED
  VULNERABILITY_EDITED
  VULNERABILITY_CHANGE_REQUESTED
  VULNERABILITY_CHANGE_APPROVED
  VULNERABILITY_CHANGE_REJECTED
  QUIZ_QUESTION_LIVE
  QUIZ_ANSWER_REVEALED
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole

  assignedTlId  String?   @map("assigned_tl_id")
  assignedTl    User?     @relation("TeamLeadTester", fields: [assignedTlId], references: [id])
  testers       User[]    @relation("TeamLeadTester")

  managerId     String?   @map("manager_id")
  manager       User?     @relation("UserManager", fields: [managerId], references: [id])
  subordinates  User[]    @relation("UserManager")

  fullName      String?   @map("full_name")
  phone         String?   @map("phone")
  designation   String?   @map("designation")

  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  isForcePasswordChange Boolean @default(false) @map("is_force_password_change")

  totpSecret    String?   @map("totp_secret")
  isTotpEnabled Boolean   @default(false) @map("is_totp_enabled")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  projectsOwned    Project[] @relation("ProjectTester")
  projectsManaged  Project[] @relation("ProjectTL")
  findings         Finding[]
  auditLogsAsActor AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTarget")
  templatesUploaded ReportTemplate[]
  reportGenerations ReportGeneration[]
  vulnRequests     Vulnerability[] @relation("VulnRequester")
  vulnReviews      Vulnerability[] @relation("VulnReviewer")
  vulnChangeRequests VulnerabilityChangeRequest[] @relation("VulnChangeRequester")
  vulnChangeTargetTl VulnerabilityChangeRequest[] @relation("VulnChangeTargetTl")
  vulnChangeReviews  VulnerabilityChangeRequest[] @relation("VulnChangeReviewer")
  notifications    Notification[]
  quizQuestions    QuizQuestion[]
  quizAttempts     QuizAttempt[]
  quizStats        QuizUserStats?
  patternMapScores PatternMapScore[]

  @@index([assignedTlId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  clientName  String        @map("client_name")
  scope       String?
  startDate   DateTime      @map("start_date")
  startDateChangedAt DateTime? @map("start_date_changed_at")
  endDate     DateTime?     @map("end_date")
  status      ProjectStatus @default(NOT_STARTED)
  complianceStatus String?   @default("In-Progress") @map("compliance_status")
  complianceType ComplianceType? @map("compliance_type")

  testerId    String        @map("tester_id")
  tester      User          @relation("ProjectTester", fields: [testerId], references: [id])
  tlId        String        @map("tl_id")
  tl          User          @relation("ProjectTL", fields: [tlId], references: [id])

  templateId  String?       @map("template_id")
  template    ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  category    TemplateCategory @default(VAPT) @map("category")
  subType     TemplateSubType  @default(WEB) @map("sub_type")

  // Report detail fields
  appVersion         String?  @map("app_version")
  location           String?  @map("location")
  documentVersion    String?  @map("document_version")
  toolsUsed          String?  @map("tools_used")
  testingEnvironment String?  @map("testing_environment")
  qaReviewerName     String?  @map("qa_reviewer_name")
  applicationDetails String?  @map("application_details")
  testingType        String?  @map("testing_type")
  loginSystemTypes   String?  @map("login_system_types")
  applicationNature  String?  @map("application_nature")
  testingLimitation  String?  @map("testing_limitation")
  mobilePlatform     String?  @map("mobile_platform")
  sha1               String?  @map("sha1")
  externalInternal   String?  @map("external_internal")
  totalScopeCount    Int?     @map("total_scope_count")
  networkScope       Json?    @map("network_scope")
  quarter            String?  @map("quarter")
  nmapPorts          Json?    @map("nmap_ports")
  // Structured rows for {Tool Name}/{Tool Version}/{Open Source/Licensed} —
  // toolsUsed (free text) is kept in sync as a derived summary so the
  // existing {Tools Used} single-line placeholder keeps working.
  toolsUsedTable     Json?    @map("tools_used_table")

  // Next report generation for this project is "1.{reportVersionCounter}".
  // Only incremented when a generation actually COMPLETEs (never on
  // creation/failure), and never decremented — so failed generations don't
  // burn a version number, and deleting an old report can't cause reuse.
  reportVersionCounter Int    @default(0) @map("report_version_counter")

  customFieldValues Json?   @map("custom_field_values")

  reportDocxPath  String?   @map("report_docx_path")
  reportPdfPath   String?   @map("report_pdf_path")
  generatedAt     DateTime? @map("generated_at")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  findings    Finding[]
  reportGenerations ReportGeneration[]

  @@index([testerId])
  @@index([tlId])
  @@index([status])
  @@index([templateId])
  @@map("projects")
}

model ReportTemplate {
  id            String    @id @default(cuid())
  name          String
  filePath      String    @map("file_path")
  /// Original uploaded filename (e.g. "App-Security-Test_{Client-Name}_{Application-Name}_Web_{Document Version}_{Report Generation Date}_Non-Compliant.docx"),
  /// used as the naming pattern for generated reports. Null for templates
  /// uploaded before this column existed.
  originalFileName String? @map("original_file_name")
  fileHash      String    @map("file_hash")

  category      TemplateCategory @default(VAPT) @map("category")
  subType       TemplateSubType  @default(WEB) @map("sub_type")
  projectType   String    @map("project_type")

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")

  uploadedById  String    @map("uploaded_by")
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projects      Project[]
  fields        TemplateField[]
  reportGenerations ReportGeneration[]

  @@index([category])
  @@index([subType])
  @@index([projectType])
  @@index([isActive])
  @@index([effectiveFrom])
  @@map("report_templates")
}

model TemplateField {
  id            String    @id @default(cuid())
  templateId    String    @map("template_id")
  template      ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name          String
  normalizedName String   @map("normalized_name")
  category      TemplateFieldCategory @default(OTHER) @map("field_category")
  description   String?
  isRepeatable  Boolean   @default(false) @map("is_repeatable")
  isCustom      Boolean   @default(false) @map("is_custom")
  sortOrder     Int       @default(0) @map("sort_order")
  /// Admin-selected canonical application parameter key this field maps to
  /// (e.g. "project.startDate"). Null = fall back to automatic fuzzy matching.
  mappedParameter String? @map("mapped_parameter")

  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([templateId])
  @@index([category])
  @@map("template_fields")
}

model ReportGeneration {
  id            String    @id @default(cuid())

  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Nullable + SetNull: deleting the source template (e.g. on replace) must
  /// never touch this row or its already-generated docxPath/pdfPath file —
  /// it just severs the "which template produced this" pointer.
  templateId    String?   @map("template_id")
  template      ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  generatedById String    @map("generated_by")
  generatedBy   User      @relation(fields: [generatedById], references: [id])

  fieldData     Json      @map("field_data")
  version       String    @default("1.0")
  status        ReportGenerationStatus @default(PENDING)
  error         String?

  docxPath      String?   @map("docx_path")
  pdfPath       String?   @map("pdf_path")

  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([projectId])
  @@index([templateId])
  @@index([generatedById])
  @@map("report_generations")
}

model Vulnerability {
  id          String   @id @default(cuid())
  name        String
  severity    String
  cvssScore   Float?   @map("cvss_score")
  cvssVector  String?  @map("cvss_vector")
  description String
  impact      String
  remediation String
  references  String
  cveId       String?  @map("cve_id")
  cweId       String?  @map("cwe_id")
  source      String   @default("internal")
  category    VulnerabilityCategory @default(APPLICATION_API)

  status      VulnerabilityStatus @default(APPROVED) @map("status")
  isActive    Boolean  @default(true) @map("is_active")
  requestedById String? @map("requested_by")
  requestedBy User?    @relation("VulnRequester", fields: [requestedById], references: [id])
  reviewedById String? @map("reviewed_by")
  reviewedBy  User?    @relation("VulnReviewer", fields: [reviewedById], references: [id])
  reviewedAt  DateTime? @map("reviewed_at")

  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  findings    Finding[]
  changeRequests VulnerabilityChangeRequest[]

  @@index([severity])
  @@index([name])
  @@index([status])
  @@index([isActive])
  @@map("vulnerabilities")
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A Tester's proposed edit to an already-approved Vulnerability DB record.
// The original record is untouched until an Admin or the tester's specific
// TL approves it — see VulnerabilitiesService.approveChangeRequest.
model VulnerabilityChangeRequest {
  id              String   @id @default(cuid())

  vulnerabilityId String   @map("vulnerability_id")
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id])

  requestedById   String   @map("requested_by")
  requestedBy     User     @relation("VulnChangeRequester", fields: [requestedById], references: [id])

  // The requester's assigned TL at the time of the request — routes the
  // notification/visibility to that one TL, not every TL in the system.
  targetTlId      String?  @map("target_tl_id")
  targetTl        User?    @relation("VulnChangeTargetTl", fields: [targetTlId], references: [id])

  reviewedById    String?  @map("reviewed_by")
  reviewedBy      User?    @relation("VulnChangeReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime? @map("reviewed_at")

  status          ChangeRequestStatus @default(PENDING)

  beforeData      Json     @map("before_data")
  afterData       Json     @map("after_data")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([vulnerabilityId])
  @@index([targetTlId])
  @@map("vulnerability_change_requests")
}

model Finding {
  id           String        @id @default(cuid())
  projectId    String        @map("project_id")
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  vulnId       String        @map("vuln_id")
  vulnerability Vulnerability @relation(fields: [vulnId], references: [id])

  evidencePaths String[]     @map("evidence_paths")
  testerNotes   String       @map("tester_notes")
  status        FindingStatus @default(DRAFT)

  affectedInstances       String[] @map("affected_instances")
  authenticationType      String?  @map("authentication_type")
  proofOfConcept          String?  @map("proof_of_concept")
  vulnerabilityDependency String?  @map("vulnerability_dependency")
  reportStatus            String   @default("Open") @map("report_status")

  cvssScoreOverride       Float?   @map("cvss_score_override")
  cvssVectorOverride      String?  @map("cvss_vector_override")

  pocSteps    PocStep[]

  createdById  String        @map("created_by")
  createdBy    User          @relation(fields: [createdById], references: [id])

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([vulnId])
  @@index([status])
  @@index([reportStatus])
  @@map("findings")
}

model PocStep {
  id          String   @id @default(cuid())
  findingId   String   @map("finding_id")
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  stepNo      Int      @map("step_no")
  description String   @map("description")
  imagePath   String?  @map("image_path")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([findingId])
  @@map("poc_steps")
}

model AuditLog {
  id          String     @id @default(cuid())
  // Null once the acting user has been permanently purged (retention); the entry itself is kept.
  actorId     String?    @map("actor_id")
  actor       User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action      AuditAction
  targetType  String?    @map("target_type")
  targetId    String?    @map("target_id")
  targetUserId String?   @map("target_user_id")
  targetUser  User?      @relation("AuditTarget", fields: [targetUserId], references: [id])

  details     Json?
  ipAddress   String     @map("ip_address")
  userAgent   String     @map("user_agent")

  timestamp   DateTime   @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([timestamp])
  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String
  read        Boolean  @default(false)
  linkUrl     String?  @map("link_url")
  relatedId   String?  @map("related_id")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// Singleton row (id is always "singleton") holding all admin-configurable
// application settings as JSON. Keeping this as one flexible JSON blob
// avoids a migration for every new setting; validation of shape/ranges
// happens in SettingsService, not the schema.
model AppSettings {
  id          String   @id @default("singleton")
  data        Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum QuizStatus {
  SCHEDULED
  ACTIVE
  REVEALED
}

enum QuizBadge {
  FIRST_CORRECT
  STREAK_5
  STREAK_10
  STREAK_30
  ANSWERED_50
  ANSWERED_100
  PERFECT_WEEK
}

model QuizQuestion {
  id           String        @id @default(cuid())
  question     String
  options      String[]
  correctIndex Int
  explanation  String
  scheduledFor DateTime
  status       QuizStatus    @default(SCHEDULED)
  revealedAt   DateTime?
  createdById  String        @map("created_by_id")
  createdBy    User          @relation(fields: [createdById], references: [id])
  attempts     QuizAttempt[]
  createdAt    DateTime      @default(now())

  @@map("quiz_questions")
}

model QuizAttempt {
  id             String       @id @default(cuid())
  questionId     String       @map("question_id")
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  selectedOption Int
  isCorrect      Boolean
  pointsAwarded  Int          @default(0)
  answeredAt     DateTime     @default(now())

  @@unique([questionId, userId])
  @@map("quiz_attempts")
}

model QuizUserStats {
  userId         String      @id @map("user_id")
  user           User        @relation(fields: [userId], references: [id])
  totalPoints    Int         @default(0)
  currentStreak  Int         @default(0)
  bestStreak     Int         @default(0)
  lastAnsweredOn DateTime?
  badges         QuizBadge[]

  @@map("quiz_user_stats")
}

// Arcade "Pattern Map" break-time game. Deliberately separate from the Quiz
// tables: its scores never feed Quiz points, streaks, scorecard or leaderboard.
model PatternMapScore {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  score         Int
  roundsCleared Int      @map("rounds_cleared")
  accuracy      Int
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([score])
  @@map("pattern_map_scores")
}
