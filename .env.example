# PMIS - Docker deployment configuration.
#   cp .env.example .env     (then replace every CHANGE_ME)
#   docker compose up -d
# Never commit .env. Generate secrets with:  openssl rand -hex 32
# (no openssl? PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') }) )
# Full guide: https://sneakywarwolf.github.io/PMIS/installation.html

# ---- Required secrets ----
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# ---- Optional ----
# Password for the first 'admin' user. Leave empty to have a random one printed in the backend logs
# (docker compose logs backend | grep "First login"). You must change it at first login either way.
ADMIN_PASSWORD=
# Load fake demo users/projects (INSECURE known passwords) - for trying PMIS out only.
SEED_DEMO=false

# Port the web UI is published on (host side)
FRONTEND_PORT=3000
# The exact URL users type in the browser (used for CORS). Change when you put a domain in front.
FRONTEND_URL=http://localhost:3000
# Set to true once PMIS is served over HTTPS (cookies are then HTTPS-only). Leave false for plain http://localhost.
COOKIE_SECURE=false

# How many proxies sit between users and the backend and append to X-Forwarded-For (used for per-IP rate limits).
# 1 = users open the PMIS frontend directly. Use 2 when ONE reverse proxy / tunnel (nginx, Cloudflare) is in front.
TRUST_PROXY_HOPS=1

# Object storage (RustFS, S3-compatible) access key. The MINIO_ROOT_* names are kept so existing .env
# files keep working: MINIO_ROOT_USER is the access key and MINIO_ROOT_PASSWORD the secret key.
MINIO_ROOT_USER=pmisminio
# Optional: object storage image. Default is rustfs/rustfs:1.0.3; pin a version or digest in production.
# RUSTFS_IMAGE=rustfs/rustfs:1.0.3

# Image source/version. Pin a version in production instead of 'latest'.
PMIS_IMAGE_REPO=sneakywarwolf
PMIS_VERSION=latest

# Optional: memory ceiling per container (raise BACKEND_MEM_LIMIT if you import very large Fortify/Nessus files).
# BACKEND_MEM_LIMIT=3g
# FRONTEND_MEM_LIMIT=1536m

# Optional: run PMIS as a restricted (non-superuser) database owner. See "Run PMIS as a restricted database user" in the Deployment guide.
# PMIS_DB_USER=pmis_app
# PMIS_DB_PASSWORD=
